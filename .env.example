# Neon Postgres. Either URL works; the pooled one wins when both are set.
DATABASE_URL="postgresql://user:password@ep-example.eu-central-1.aws.neon.tech/trailcompanion?sslmode=require&channel_binding=require"
DATABASE_URL_POOLED="postgresql://user:password@ep-example-pooler.eu-central-1.aws.neon.tech/trailcompanion?sslmode=require&channel_binding=require"

# At least 32 bytes: openssl rand -base64 48
JWT_KEY=""
JWT_ISSUER="trailcompanion-api"
JWT_AUDIENCE="trailcompanion-api"
JWT_ACCESS_TOKEN_LIFETIME_MINUTES="15"

# Comma-separated origins allowed to call the API.
CORS_ALLOWED_ORIGINS="http://localhost:5173"
