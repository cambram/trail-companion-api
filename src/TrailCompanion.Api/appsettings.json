{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    },
    "Console": {
      "IncludeScopes": true
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": ""
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "Jwt": {
    "Issuer": "trailcompanion-api",
    "Audience": "trailcompanion-api",
    "Key": "",
    "AccessTokenLifetimeMinutes": 15
  },
  "FeatureManagement": {
    "RegistrationEnabled": true,
    "BreachedPasswordCheck": false
  }
}
